---
import Icon from './Icon.astro';

// [PROVISÓRIO] Se o cliente liberar o prazo do case, entra aqui no formato "em X meses".
const prazo = '';

const chips = [
  { principal: 'Google', complemento: 'Ads' },
  { principal: 'Meta', complemento: 'Ads' },
  { principal: 'CRM', complemento: 'e automação' },
];

// Curva decorativa (não é gráfico de dados): sem eixos, valores intermediários ou datas.
const curva = 'M4 136 C 80 133, 140 127, 196 112 S 318 58, 392 20';
---

<figure class="case surface-dark" data-case>
  <div class="case__top">
    <p class="case__origem">Revenda de software atendida pela Adverts</p>
    <span class="case__selo">Case real</span>
  </div>

  <p class="case__rotulo">Receita recorrente mensal (MRR)</p>

  <p class="case__numero">
    <s class="case__antes">R$ 1.500</s>
    <span class="case__para">
      <Icon name="arrowRight" size={24} class="case__seta" />
      <span class="sr-only">para</span>
      <span class="case__depois">
        <span class="case__sizer" aria-hidden="true">R$ 20.000</span>
        <span class="case__valor grad-text" aria-live="off" data-countup="20000" data-from="1500">R$ 20.000</span>
      </span>
    </span>
  </p>
  {prazo && <p class="case__prazo">{prazo}</p>}

  <svg
    class="case__grafico"
    viewBox="0 0 400 150"
    role="img"
    aria-label="Curva ascendente da receita recorrente mensal, de R$ 1.500 para R$ 20.000"
  >
    <defs>
      <linearGradient id="case-area" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" class="stop-area" />
        <stop offset="1" class="stop-area-0" />
      </linearGradient>
    </defs>
    <g class="case__guias">
      <line x1="0" y1="37.5" x2="400" y2="37.5" />
      <line x1="0" y1="75" x2="400" y2="75" />
      <line x1="0" y1="112.5" x2="400" y2="112.5" />
    </g>
    <path class="case__area" d={`${curva} L392 150 L4 150 Z`} fill="url(#case-area)" />
    <path class="case__linha" d={curva} pathLength="1" />
    <circle class="case__halo" cx="392" cy="20" r="8" />
    <circle class="case__ponto" cx="392" cy="20" r="3" />
  </svg>

  <ul class="case__chips">
    {chips.map((c) => (
      <li>
        <span class="chip__principal">{c.principal}</span>
        <span class="chip__complemento">{c.complemento}</span>
      </li>
    ))}
  </ul>
</figure>

<!--
  Animação da curva e do contador. O HTML já traz o estado final (valor e curva completos);
  a animação é só visual e começa quando o cartão entra na tela. Inline para ajustar o
  número antes da primeira pintura.
-->
<script is:inline>
  (function () {
    var card = document.querySelector('[data-case]');
    var el = card && card.querySelector('[data-countup]');
    if (!el || document.visibilityState === 'hidden' || !window.matchMedia || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var to = +el.getAttribute('data-countup'), from = +el.getAttribute('data-from'), dur = 1600;
    var fmt = function (n) { return 'R$ ' + Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.'); };
    card.classList.add('is-armed');
    el.textContent = fmt(from);
    var raf = 0;
    var play = function () {
      card.classList.add('is-play');
      var t0;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function step(t) {
        if (!t0) t0 = t;
        var p = Math.min((t - t0) / dur, 1), e = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(from + (to - from) * e);
        if (p < 1) raf = requestAnimationFrame(step);
      });
    };
    // Volta ao início quando o cartão sai da tela, para a animação se repetir na volta.
    var reset = function () {
      cancelAnimationFrame(raf);
      card.classList.remove('is-play');
      el.textContent = fmt(from);
    };
    if (!('IntersectionObserver' in window)) return play();
    new IntersectionObserver(function (entries) {
      var e = entries[0];
      if (e.intersectionRatio >= 0.4 && !card.classList.contains('is-play')) play();
      else if (!e.isIntersecting) reset();
    }, { threshold: [0, 0.4] }).observe(card);
  })();
</script>

<style>
  .case {
    position: relative;
    padding: var(--s-7);
    border: 1px solid var(--line);
    border-radius: var(--r-hero-card);
    background: linear-gradient(160deg, var(--hero-card-from), var(--hero-card-to));
    box-shadow: var(--shadow-hero-card);
  }

  .case__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .case__origem { font-size: 13px; line-height: 1.4; color: var(--muted); }
  .case__selo {
    flex: none;
    padding: 5px 11px;
    border: 1px solid var(--tint-accent-2-bd);
    border-radius: var(--r-pill);
    background: var(--tint-accent-2);
    color: var(--accent-2);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
  }

  .case__rotulo {
    margin-top: var(--s-7);
    font-size: var(--fs-micro);
    font-weight: 600;
    color: var(--muted);
  }

  .case__numero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    margin-top: var(--s-2);
    font-family: var(--font-title);
    font-weight: 700;
    line-height: 1;
  }
  .case__antes {
    font-size: 22px;
    font-weight: 500;
    color: var(--muted);
    text-decoration-thickness: 2px;
  }
  .case__para { display: inline-flex; align-items: center; gap: var(--s-3); white-space: nowrap; }
  .case__numero :global(.case__seta) { color: var(--accent-2); }
  .case__depois {
    display: inline-grid;
    font-size: 44px;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .case__sizer, .case__valor { grid-area: 1 / 1; white-space: nowrap; }
  .case__sizer { visibility: hidden; }
  .case__valor { padding-bottom: .06em; }
  .case__prazo { margin-top: var(--s-2); font-size: var(--fs-micro); color: var(--muted); }

  .case__grafico {
    width: 100%;
    height: auto;
    margin-top: var(--s-6);
    overflow: visible;
  }
  .stop-area { stop-color: var(--chart-area); }
  .stop-area-0 { stop-color: var(--chart-area-0); }
  .case__guias line { stroke: var(--line); stroke-width: 1; }

  .case__linha {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .case__ponto { fill: var(--accent-2); }
  .case__halo { fill: var(--tint-accent-2-bd); }

  /* Estado inicial só quando o JS armou a animação; sem JS a curva já aparece completa. */
  .case.is-armed .case__linha { stroke-dashoffset: 1; }
  .case.is-armed .case__area,
  .case.is-armed .case__ponto,
  .case.is-armed .case__halo { opacity: 0; }

  .case.is-play .case__linha { animation: case-draw 1.6s ease-out forwards; }
  .case.is-play .case__area { animation: case-fade .9s ease-out .75s forwards; }
  .case.is-play .case__ponto,
  .case.is-play .case__halo { animation: case-fade .3s ease-out 1.45s forwards; }

  @keyframes case-draw { to { stroke-dashoffset: 0; } }
  @keyframes case-fade { to { opacity: 1; } }

  .case__chips {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-2);
    margin-top: var(--s-6);
  }
  .case__chips li {
    display: flex;
    flex-direction: column;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--chip-bg);
    line-height: 1.3;
  }
  .chip__principal { font-size: 15px; font-weight: 700; color: var(--text); }
  .chip__complemento { font-size: 13px; color: var(--muted); }

  @media (max-width: 379px) {
    .case { padding: var(--s-5); }
    .case__depois { font-size: 38px; }
  }
</style>
