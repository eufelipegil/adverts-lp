---
// [PROVISÓRIO] Nenhum ID foi fornecido ainda. Cada script só é injetado se a variável existir.
// Nunca chute um ID: preencha no .env local e nas variáveis do Cloudflare Pages.
const GA4_ID = import.meta.env.PUBLIC_GA4_ID?.trim() || '';
const GADS_ID = import.meta.env.PUBLIC_GADS_ID?.trim() || '';
const GADS_LABEL = import.meta.env.PUBLIC_GADS_CONV_LABEL?.trim() || '';
const META_PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID?.trim() || '';
const WIDZ_TRACK = import.meta.env.PUBLIC_WIDZ_TRACK?.trim() || '';

const gtagId = GA4_ID || GADS_ID;
const gtagConfigs = [GA4_ID, GADS_ID].filter(Boolean);
const gadsSendTo = GADS_ID && GADS_LABEL ? `${GADS_ID}/${GADS_LABEL}` : '';
// Widz Track: slot reservado para o snippet que o Felipe vai fornecer (só entra se for HTML completo).
const widzSnippet = WIDZ_TRACK.startsWith('<') ? WIDZ_TRACK : '';
---

{gtagId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gtagId}`}></script>}
{gtagId && (
  <script is:inline define:vars={{ gtagConfigs }}>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    gtag('js', new Date());
    gtagConfigs.forEach(function (id) { gtag('config', id); });
  </script>
)}

{META_PIXEL_ID && (
  <script is:inline define:vars={{ META_PIXEL_ID }}>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
    document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', META_PIXEL_ID);
    fbq('track', 'PageView');
  </script>
)}

{widzSnippet && <Fragment set:html={widzSnippet} />}

<!--
  Clique no WhatsApp: um único listener delegado para a[data-cta].
  Não atrasa nem bloqueia o clique (sem preventDefault); cada chamada é protegida.
-->
<script is:inline define:vars={{ gadsSendTo }}>
  window.dataLayer = window.dataLayer || [];
  function onCta(e) {
    if (e.type === 'auxclick' && e.button !== 1) return;
    var a = e.target && e.target.closest && e.target.closest('a[data-cta]');
    if (!a) return;
    var id = a.getAttribute('data-cta');
    try {
      if (window.gtag) {
        window.gtag('event', 'clique_whatsapp', { cta_id: id });
        if (gadsSendTo) window.gtag('event', 'conversion', { send_to: gadsSendTo });
      }
    } catch (_) {}
    try { if (window.fbq) window.fbq('track', 'Contact', { content_name: id }); } catch (_) {}
    try { window.dataLayer.push({ event: 'clique_whatsapp', cta_id: id }); } catch (_) {}
  }
  document.addEventListener('click', onCta, true);
  document.addEventListener('auxclick', onCta, true);
</script>
