---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CredStrip from '../components/CredStrip.astro';
import Dores from '../components/Dores.astro';
import PorQue from '../components/PorQue.astro';
import Servicos from '../components/Servicos.astro';
import Resultado from '../components/Resultado.astro';
import Depoimentos from '../components/Depoimentos.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Socios from '../components/Socios.astro';
import Projetos from '../components/Projetos.astro';
import ParaQuem from '../components/ParaQuem.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
