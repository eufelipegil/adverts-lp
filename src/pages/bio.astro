---
// Página do link da bio do Instagram. Enxuta, fora do Google (noindex) e do sitemap.
// Textos reaproveitados da copy aprovada; a mensagem do WhatsApp (cta_bio) está em ctas.ts.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import WidzCredit from '../components/WidzCredit.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { socios } from '../data/socios';
import { credibilidade } from '../data/credibilidade';

// Só o que já está aprovado no site: nada inventado para a bio.
const fotosSocios = socios.flatMap((so) => (so.foto ? [so.foto] : []));
const provas = [credibilidade[0], credibilidade[2], credibilidade[3]];
const atalhos = [
  { href: '/#como-funciona', texto: 'Como funciona', icone: 'message' },
  { href: '/#duvidas', texto: 'Dúvidas', icone: 'help' },
  { href: '/', texto: 'Site da Adverts', icone: 'home' },
] as const;

let n = 0;
const ordem = () => `--i:${n++}`;
---

<Base
  title="Adverts | Links"
  description="Fale com a Adverts no WhatsApp e conheça o trabalho de marketing e tráfego pago para revendas de software."
  path="/bio"
  noindex
  progresso={false}
>
  <main class="bio" data-tone="escuro">
    <div class="bio__col">
      <header class="bio__topo">
        <div class="bio__marca">
          <a href="/" class="bio__avatar bio__in" style={ordem()} aria-label="Adverts, página inicial">
            <Logo variante="simbolo" class="bio__simbolo" />
          </a>
        </div>
        <h1 class="bio__titulo bio__in" style={ordem()}>{site.nome}</h1>
        <p class="bio__desc bio__in" style={ordem()}>{site.slogan}</p>
        <p class="bio__chip bio__in" style={ordem()}>Marketing e tráfego pago para revendas de software</p>
        <p class="bio__time bio__in" style={ordem()}>
          <span class="bio__fotos" aria-hidden="true">
            {fotosSocios.map((f) => <Image src={f} alt="" width={72} height={72} class="bio__foto" />)}
          </span>
          <span class="bio__time-texto"><strong>Quatro sócios</strong> de tecnologia, tráfego e vendas</span>
        </p>
      </header>

      <ul class="bio__provas bio__in" style={ordem()} aria-label="Em resumo">
        {provas.map((p) => (
          <li>
            <span class="bio__prova-ico"><Icon name={p.icone} size={20} /></span>
            <strong>{p.principal}</strong>
            {p.resto && <span class="bio__prova-resto">{p.resto}</span>}
          </li>
        ))}
      </ul>

      <nav class="bio__links" aria-label="Links da Adverts">
        <div class="bio__in" style={ordem()}>
          <WhatsAppButton ctaId="cta_bio" class="bio__wa" />
        </div>
        <ul class="bio__lista">
          {atalhos.map((a) => (
            <li class="bio__in" style={ordem()}>
              <a class="bio__link" href={a.href}>
                <span class="bio__link-icone"><Icon name={a.icone} size={18} /></span>
                <span>{a.texto}</span>
                <Icon name="arrowUpRight" size={16} class="bio__seta" />
              </a>
            </li>
          ))}
          <li class="bio__in" style={ordem()}>
            <a class="bio__link" href={`mailto:${site.email}`}>
              <span class="bio__link-icone"><Icon name="mail" size={18} /></span>
              <span class="bio__email">{site.email}</span>
              <Icon name="arrowUpRight" size={16} class="bio__seta" />
            </a>
          </li>
        </ul>
      </nav>

      <p class="bio__horario bio__in" style={ordem()}>
        <Icon name="clock" size={15} />{site.horario} · Atendimento online para todo o Brasil
      </p>

      <div class="bio__credito bio__in" style={ordem()}><WidzCredit /></div>
    </div>
  </main>
</Base>

<style>
  .bio {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    padding: max(48px, env(safe-area-inset-top)) var(--gutter) max(36px, env(safe-area-inset-bottom));
    background:
      radial-gradient(90% 55% at 100% 0%, var(--glow-accent), transparent 70%),
      radial-gradient(80% 45% at 0% 100%, var(--glow-accent-2), transparent 70%);
    overflow: clip;
  }
  .bio__col { max-width: 440px; margin-inline: auto; display: grid; gap: var(--s-7); }

  /* ---------- topo ---------- */
  .bio__topo { display: grid; justify-items: center; gap: var(--s-3); text-align: center; }
  .bio__avatar {
    display: grid;
    place-items: center;
    width: 92px;
    height: 92px;
    margin-bottom: var(--s-2);
    border-radius: 26px;
    color: var(--text);
    background: var(--glass-fill), var(--card);
    border: 1px solid var(--glass-border);
    box-shadow: inset 0 1px 0 var(--glass-edge), var(--glass-shadow);
  }
  /* sócios: fotos sobrepostas ao lado de uma linha de texto, sem link */
  .bio__marca { margin-bottom: var(--s-2); }
  .bio__time { display: flex; align-items: center; justify-content: center; justify-self: center; width: fit-content; gap: var(--s-3); margin-top: var(--s-2); }
  .bio__fotos { display: flex; flex: none; }
  .bio__fotos :global(.bio__foto) {
    width: 38px;
    height: 38px;
    object-fit: cover;
    object-position: top;
    border-radius: 50%;
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 1px var(--tint-accent-2-bd);
  }
  .bio__fotos :global(.bio__foto) + :global(.bio__foto) { margin-left: -12px; }
  .bio__time-texto { font-size: 13px; line-height: 1.35; color: var(--muted); text-align: left; text-wrap: balance; }
  .bio__time-texto strong { color: var(--text); font-weight: 600; }

  /* pulso âmbar atrás do logo: duas ondas defasadas + brilho fixo */
  .bio__avatar { position: relative; isolation: isolate; }
  .bio__avatar::before,
  .bio__avatar::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 26px;
    border: 1.5px solid var(--accent-2);
    opacity: 0;
    pointer-events: none;
  }
  .bio__topo::before {
    content: '';
    position: absolute;
    top: -30px;
    left: 50%;
    width: 260px;
    height: 260px;
    translate: -50% 0;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(253, 185, 19, .22), transparent 72%);
    pointer-events: none;
  }
  .bio__topo { position: relative; }
  @media (prefers-reduced-motion: no-preference) {
    .bio__avatar::before { animation: bio-pulso 3.2s var(--ease-out-quart) 1.2s infinite; }
    .bio__avatar::after { animation: bio-pulso 3.2s var(--ease-out-quart) 2.8s infinite; }
    .bio__topo::before { animation: bio-respira 3.2s ease-in-out 1.2s infinite; }
  }
  @keyframes bio-pulso {
    0% { opacity: .75; scale: 1; }
    100% { opacity: 0; scale: 1.9; }
  }
  @keyframes bio-respira {
    0%, 100% { opacity: .65; scale: .92; }
    50% { opacity: 1; scale: 1.08; }
  }
  .bio__avatar :global(.bio__simbolo) { width: 62px; height: auto; }
  .bio__titulo { font-size: 22px; line-height: 1.25; letter-spacing: -0.01em; }
  .bio__desc { max-width: 30ch; color: var(--muted); font-size: 15px; line-height: 1.5; }
  .bio__chip {
    margin-top: var(--s-1);
    padding: 7px 14px;
    border: 1px solid var(--tint-accent-2-bd);
    border-radius: var(--r-pill);
    background: var(--tint-accent-2);
    color: var(--label-ink);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
    text-wrap: balance;
  }

  /* ---------- provas: um painel só, três colunas, luz âmbar na borda ---------- */
  .bio__provas {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    background: var(--glass-fill), var(--card);
    box-shadow: inset 0 1px 0 var(--glass-edge-soft), 0 18px 40px -24px rgba(0, 0, 0, .8);
  }
  /* luz âmbar que percorre a borda do painel em loop */
  @property --bio-ang { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  .bio__provas::before {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1.5px;
    border-radius: inherit;
    background: conic-gradient(from var(--bio-ang), transparent 0deg 250deg, rgba(253, 185, 19, .35) 300deg, var(--accent-2) 340deg, transparent 360deg);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .bio__provas::before { animation: bio-gira 5s linear infinite; }
  }
  @keyframes bio-gira { to { --bio-ang: 360deg; } }
  .bio__provas li {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 3px;
    padding: 16px 8px 15px;
    text-align: center;
    font-size: 11.5px;
    line-height: 1.35;
    color: var(--muted);
  }
  .bio__provas li + li { border-left: 1px solid var(--line); }
  .bio__prova-ico {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    margin-bottom: 6px;
    border-radius: 12px;
    background: var(--tint-accent-2);
    border: 1px solid var(--tint-accent-2-bd);
    color: var(--accent-2);
    box-shadow: 0 0 18px -4px rgba(253, 185, 19, .45);
  }
  .bio__provas strong { color: var(--text); font-size: 13px; font-weight: 600; line-height: 1.25; text-wrap: balance; }
  .bio__prova-resto { text-wrap: balance; }

  /* ---------- links ---------- */
  .bio__links { display: grid; gap: var(--s-3); }
  .bio__links :global(.bio__wa) { width: 100%; padding-inline: 18px; }
  .bio__lista { display: grid; gap: var(--s-3); }
  .bio__link {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: 36px 1fr auto;
    align-items: center;
    gap: var(--s-3);
    min-height: 58px;
    padding: 10px 16px 10px 11px;
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    background: var(--glass-fill), var(--card);
    box-shadow: inset 0 1px 0 var(--glass-edge-soft);
    font-weight: 600;
    color: var(--text);
    transition: border-color .3s ease, scale .2s var(--ease-out-quart);
  }
  /* preenchimento azul que corre da esquerda no hover/toque */
  .bio__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, var(--tint-accent), transparent 85%);
    translate: -101% 0;
    transition: translate .6s var(--ease-out-expo);
  }
  .bio__link:hover::before, .bio__link:focus-visible::before { translate: 0 0; }
  .bio__link:hover { border-color: var(--line-2); }
  .bio__link:active { scale: .98; }
  .bio__link-icone {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--tint-accent);
    color: var(--accent);
  }
  .bio__link :global(.bio__seta) { color: var(--muted); transition: translate .35s var(--ease-out-expo), color .2s ease; }
  .bio__link:hover :global(.bio__seta) { translate: 2px -2px; color: var(--text); }
  .bio__email { font-size: 14px; letter-spacing: -0.01em; overflow-wrap: anywhere; }

  /* ---------- rodapé ---------- */
  .bio__horario {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: var(--s-2);
    text-align: center;
    font-size: 13px;
    color: var(--muted);
  }
  .bio__horario :global(svg) { flex: none; margin-top: 2px; }
  .bio__rodape {
    display: flex;
    justify-content: space-between;
    gap: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    font-size: 13px;
  }
  .bio__rodape a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; color: var(--muted); transition: color .2s ease; }
  .bio__rodape a:hover { color: var(--text); }

  .bio__credito { display: flex; justify-content: center; }

  /* ---------- entrada: blocos sobem em sequência (só CSS) ---------- */
  /* O topo (avatar, nome, slogan) não começa invisível: é o primeiro conteúdo pintado da página. */
  @media (prefers-reduced-motion: no-preference) {
    .bio__in { animation: bio-sobe .9s var(--ease-out-expo) both; animation-delay: calc(.08s + var(--i, 0) * 60ms); }
    .bio__topo .bio__in { animation-name: bio-assenta; }
    .bio__avatar { animation-name: bio-avatar; animation-duration: 1.1s; }
  }
  @keyframes bio-sobe { from { opacity: 0; translate: 0 18px; } }
  @keyframes bio-assenta { from { translate: 0 12px; } }
  @keyframes bio-avatar { from { scale: .8; rotate: -12deg; } }
</style>
