---
import Logo from './Logo.astro';
import WidzCredit from './WidzCredit.astro';
import Icon from './Icon.astro';
import { ctas } from '../data/ctas';
import { site } from '../data/site';
import { waLink } from '../lib/whatsapp';

const ano = new Date().getFullYear();
const nav = [
  { href: '/#servicos', texto: 'O que fazemos' },
  { href: '/#depoimento', texto: 'Depoimento' },
  { href: '/#como-funciona', texto: 'Como funciona' },
  { href: '/#socios', texto: 'Os sócios' },
  { href: '/#projetos', texto: 'Projetos' },
  { href: '/#duvidas', texto: 'Dúvidas' },
] as const;
// Slogan em 3 linhas no rodapé: "Marketing para quem / constrói o futuro da / tecnologia."
const sloganLinhas = site.slogan.replace('quem ', 'quem\n').replace('futuro da ', 'futuro da\n').split('\n');
const empresa = [site.razaoSocial, site.cnpj && `CNPJ ${site.cnpj}`].filter(Boolean).join(' · ');
---

<footer class="footer surface-dark" data-tone="escuro">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__marca">
        <a href="/#topo" class="footer__logo" aria-label="Adverts, voltar ao topo"><Logo class="footer__svg" /></a>
        <p class="footer__slogan">{sloganLinhas.map((l, i) => <Fragment>{i > 0 && <br />}{l}</Fragment>)}</p>

        <ul class="footer__redes" aria-label="Redes sociais">
          <li>
            <a class="footer__rede" href={site.redes.instagram.url} target="_blank" rel="noopener" aria-label={`Instagram da Adverts, ${site.redes.instagram.usuario}`}>
              <Icon name="instagram" size={20} />
            </a>
          </li>
          {site.redes.facebook.url && (
            <li>
              <a class="footer__rede" href={site.redes.facebook.url} target="_blank" rel="noopener" aria-label={`Facebook da Adverts, ${site.redes.facebook.nome}`}>
                <Icon name="facebook" size={20} />
              </a>
            </li>
          )}
        </ul>
      </div>

      <nav class="footer__nav" aria-label="Navegação do rodapé">
        <h2 class="footer__titulo">Navegue</h2>
        <ul>
          {nav.map((i) => <li><a href={i.href}>{i.texto}</a></li>)}
        </ul>
      </nav>

      <div class="footer__contato-bloco">
        <h2 class="footer__titulo">Contato</h2>
        <ul class="footer__contato">
          <li>
            <a class="footer__item footer__item--wa" href={waLink('cta_rodape')} data-cta="cta_rodape" target="_blank" rel="noopener">
              <span class="footer__ic"><Icon name="whatsapp" size={20} /></span>
              <span class="footer__item-txt"><small>WhatsApp</small><strong>{site.whatsapp.exibicao}</strong></span>
              <Icon name="arrowUpRight" size={16} class="footer__seta" />
            </a>
          </li>
          <li>
            <a class="footer__item" href={`mailto:${site.email}`}>
              <span class="footer__ic"><Icon name="mail" size={20} /></span>
              <span class="footer__item-txt"><small>E-mail</small><strong>{site.email}</strong></span>
              <Icon name="arrowUpRight" size={16} class="footer__seta" />
            </a>
          </li>
          <li>
            <a class="footer__item" href={site.cidade.mapa} target="_blank" rel="noopener">
              <span class="footer__ic"><Icon name="pin" size={20} /></span>
              <span class="footer__item-txt"><small>Onde estamos</small><strong>{site.cidade.nome}, {site.cidade.uf}</strong></span>
              <Icon name="arrowUpRight" size={16} class="footer__seta" />
            </a>
          </li>
          <li>
            <div class="footer__item footer__item--fixo">
              <span class="footer__ic"><Icon name="clock" size={20} /></span>
              <span class="footer__item-txt"><small>Atendimento</small><strong>{site.horario}</strong></span>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__base">
      <p class="footer__copy">
        © {ano} {site.nome}. Todos os direitos reservados.{empresa && <> {empresa}</>}
      </p>
      <div class="footer__direita">
        <a class="footer__legal" href="/politica-de-privacidade/">Política de privacidade</a>
        <WidzCredit />
      </div>
    </div>
  </div>
</footer>

<style>
  /* Rodapé sempre escuro (base da página), em qualquer tom: mantém o crédito da widz legível */
  .footer {
    padding: var(--s-11) 0 var(--s-6);
    border-top: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.15fr .75fr 1.3fr;
    gap: var(--s-10);
    align-items: start;
  }
  .footer__logo { display: inline-block; color: var(--text); }
  .footer__logo :global(.footer__svg) { display: block; width: auto; height: 72px; }
  .footer__slogan { margin-top: var(--s-4); max-width: 320px; font-size: 16px; line-height: 1.5; color: var(--muted); }
  .footer__titulo {
    font-family: var(--font-title);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: .02em;
    color: var(--accent-2); /* amarelo da marca */
  }
  .footer ul { list-style: none; }

  /* ---------- redes: só os ícones, em círculos; no hover/foco ficam no amarelo da marca ---------- */
  .footer__redes { display: flex; gap: var(--s-3); margin-top: var(--s-6); }
  .footer__rede {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    color: var(--text);
    transition: color .25s ease, border-color .25s ease, background-color .25s ease, translate .35s var(--ease-out-expo);
  }
  .footer__rede:hover,
  .footer__rede:focus-visible {
    color: var(--accent-2);
    border-color: var(--accent-2);
    background: var(--tint-accent-2);
    translate: 0 -2px;
  }

  /* ---------- navegação ---------- */
  .footer__nav ul { display: grid; gap: 2px; margin-top: var(--s-4); }
  .footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 15px;
    color: var(--muted);
    transition: color .2s ease, translate .3s var(--ease-out-expo);
  }
  .footer__nav a:hover, .footer__nav a:focus-visible { color: var(--text); translate: 4px 0; }

  /* ---------- contato: lista limpa, ícone simples + rótulo + valor, separados por uma linha fina ---------- */
  .footer__contato { display: grid; margin-top: var(--s-3); }
  .footer__contato li + li { border-top: 1px solid var(--line); }
  .footer__item {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    min-height: 60px;
    padding-block: var(--s-3);
    color: var(--text);
  }
  .footer__ic { display: grid; place-items: center; flex: none; width: 24px; color: var(--muted); transition: color .25s ease; }
  a.footer__item:hover .footer__ic, a.footer__item:focus-visible .footer__ic { color: var(--accent-2); }
  .footer__item--wa .footer__ic { color: var(--brand-green); }
  .footer__item-txt { display: grid; min-width: 0; line-height: 1.35; }
  .footer__item-txt small { font-size: 12px; color: var(--muted); }
  .footer__item-txt strong { font-size: 15px; font-weight: 500; color: var(--text); overflow-wrap: anywhere; transition: color .2s ease; }
  a.footer__item:hover .footer__item-txt strong { color: var(--accent-2); }
  /* a setinha só aparece ao passar o mouse ou focar */
  .footer__item :global(.footer__seta) { margin-left: auto; flex: none; color: var(--muted); opacity: 0; translate: -4px 4px; transition: opacity .25s ease, translate .3s var(--ease-out-expo); }
  a.footer__item:hover :global(.footer__seta), a.footer__item:focus-visible :global(.footer__seta) { opacity: 1; translate: 0 0; }

  /* ---------- base ---------- */
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-2) var(--s-6);
    margin-top: var(--s-10);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
  }
  .footer__legal { display: inline-flex; align-items: center; min-height: 44px; transition: color .2s ease; }
  .footer__legal:hover { color: var(--text); }
  .footer__direita { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-6); }

  @media (max-width: 959px) {
    .footer__grid { grid-template-columns: 1fr 1fr; gap: var(--s-9) var(--s-8); }
    .footer__marca { grid-column: 1 / -1; }
    .footer__contato-bloco { grid-column: 1 / -1; }
    .footer__contato { grid-template-columns: 1fr 1fr; column-gap: var(--s-8); }
    .footer__contato li:nth-child(2) { border-top: 0; }
  }
  @media (max-width: 619px) {
    .footer { padding-top: var(--s-10); }
    .footer__grid { grid-template-columns: 1fr; }
    .footer__contato { grid-template-columns: 1fr; }
    .footer__nav ul { grid-template-columns: 1fr 1fr; column-gap: var(--s-4); }
  }
</style>
