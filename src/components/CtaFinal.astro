---
import WhatsAppButton from './WhatsAppButton.astro';
import Words from './Words.astro';
import Logo from './Logo.astro';
import { site } from '../data/site';
import { ctas } from '../data/ctas';

const frase1 = 'Seu próximo cliente já está procurando um sistema.';
const frase2 = 'Ele vai encontrar a sua revenda ou a do concorrente?';
---

<section class="section final" aria-labelledby="final-titulo" data-tone="escuro">
  <div class="container final__grade">
    <div class="final__texto">
      <p class="label" data-reveal="label">Escale sua revenda de tecnologia</p>
      <h2 id="final-titulo" data-reveal="words">
        <Words text={frase1} /><br /><Words text={frase2} class="grad-text" start={frase1.split(' ').length} />
      </h2>
      <p class="final__apoio" data-reveal="up" style="--d0:400ms">Chama a gente no WhatsApp, conta como a sua revenda vende hoje e a gente marca a conversa de triagem.</p>
      <WhatsAppButton ctaId="cta_final" class="final__cta" data-reveal="up" style="--d0:520ms" />
      <p class="micro final__micro" data-reveal="up" style="--d0:600ms">Sem compromisso · {site.horario}</p>
    </div>

    <!-- Prévia ilustrativa: mostra a mensagem que o botão já deixa pronta no WhatsApp -->
    <div class="chat-palco" aria-hidden="true">
    <span class="chat-luz chat-luz--azul"></span>
    <span class="chat-luz chat-luz--amarela"></span>
    <div class="chat-flutua">
    <div class="chat" data-reveal="right" style="--d0:300ms" data-chat>
      <div class="chat__topo">
        <span class="chat__avatar"><Logo variante="simbolo" /></span>
        <span class="chat__nome">Adverts</span>
        <span class="chat__via">WhatsApp</span>
      </div>
      <div class="chat__corpo">
        <p class="chat__bolha" data-chat-bolha>{ctas.cta_final.mensagem}</p>
        <p class="chat__dica" data-chat-dica>Mensagem pronta. É só enviar.</p>
      </div>
      <div class="chat__rodape">
        <span class="chat__campo" data-chat-campo>{ctas.cta_final.mensagem}</span>
        <span class="chat__enviar" data-chat-enviar><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M3.4 20.4 21 12 3.4 3.6l.01 6.5L15 12 3.4 13.9z" /></svg></span>
      </div>
    </div>
    </div>
    </div>
  </div>
</section>

<script>
  // Prévia viva: a mensagem é digitada no campo, o botão de enviar pulsa e ela aparece no balão.
  // Repete em loop só enquanto a prévia está na tela. Sem movimento, fica a versão estática.
  const chat = document.querySelector<HTMLElement>('[data-chat]');
  const campo = chat?.querySelector<HTMLElement>('[data-chat-campo]');
  if (chat && campo && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const texto = campo.textContent || '';
    const espera = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let visivel = false;
    let rodando = false;
    const ciclo = async () => {
      if (rodando) return;
      rodando = true;
      while (visivel) {
        chat.classList.remove('is-enviado', 'is-pulso');
        campo.textContent = '';
        chat.classList.add('is-digitando');
        await espera(700);
        for (let i = 1; i <= texto.length && visivel; i++) {
          campo.textContent = texto.slice(0, i);
          await espera(texto[i - 1] === ' ' ? 70 : 34 + Math.random() * 40);
        }
        chat.classList.remove('is-digitando');
        await espera(500);
        chat.classList.add('is-pulso');
        await espera(260);
        campo.textContent = '';
        chat.classList.add('is-enviado');
        await espera(5200);
      }
      // saiu da tela: volta ao estado completo
      chat.classList.remove('is-digitando', 'is-pulso');
      chat.classList.add('is-enviado');
      campo.textContent = texto;
      rodando = false;
    };
    chat.classList.add('chat--vivo', 'is-enviado');
    new IntersectionObserver(([e]) => {
      visivel = e.isIntersecting;
      if (visivel) ciclo();
    }, { threshold: 0.4 }).observe(chat);
  }
</script>

<style>
  .final { border-top: 1px solid var(--line); }
  .final__grade {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
    gap: var(--s-10);
    align-items: center;
  }
  .final__texto { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .final h2 { margin-top: var(--s-4); max-width: 20ch; font-size: clamp(30px, 3.9vw, 50px); line-height: 1.08; }
  .final__apoio { max-width: 520px; margin-top: var(--s-6); font-size: 18px; color: var(--muted); }
  .final :global(.final__cta) { margin-top: var(--s-8); }
  .final__micro { margin-top: var(--s-4); }

  /* ---------- prévia do WhatsApp ---------- */
  /* palco: luzes da marca passeando atrás + flutuação lenta e contínua */
  .chat-palco { position: relative; isolation: isolate; justify-self: end; width: 100%; max-width: 420px; }
  .chat-luz {
    position: absolute;
    z-index: -1;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(70px);
    opacity: .55;
    pointer-events: none;
  }
  .chat-luz--azul { top: -10%; left: -15%; background: var(--brand-blue); animation: luz-a 14s ease-in-out infinite alternate; }
  .chat-luz--amarela { bottom: -12%; right: -12%; width: 50%; background: var(--brand-yellow); opacity: .28; animation: luz-b 11s ease-in-out infinite alternate; }
  @keyframes luz-a { to { translate: 30% 25%; scale: 1.2; } }
  @keyframes luz-b { to { translate: -35% -30%; scale: .85; } }
  .chat-flutua { animation: flutua 7s ease-in-out infinite; }
  @keyframes flutua {
    0%, 100% { translate: 0 0; rotate: 0deg; }
    50% { translate: 0 -14px; rotate: -1.2deg; }
  }

  /* estados da prévia viva (script acima) */
  .chat--vivo .chat__bolha,
  .chat--vivo .chat__dica {
    opacity: 0;
    translate: 0 14px;
    scale: .92;
    transform-origin: 100% 100%;
    transition: opacity .35s ease, translate .6s var(--ease-out-expo), scale .6s var(--ease-out-expo);
  }
  .chat--vivo.is-enviado .chat__bolha,
  .chat--vivo.is-enviado .chat__dica { opacity: 1; translate: 0 0; scale: 1; }
  .chat--vivo.is-enviado .chat__dica { transition-delay: .25s; }
  .chat--vivo.is-digitando .chat__campo { color: var(--text); }
  .chat--vivo.is-digitando .chat__campo::after {
    content: '';
    display: inline-block;
    width: 1.5px;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: cursor .9s steps(1) infinite;
  }
  @keyframes cursor { 50% { opacity: 0; } }
  .chat__enviar { transition: scale .25s var(--ease-out-quart), box-shadow .4s ease; }
  .chat--vivo.is-pulso .chat__enviar { scale: .82; box-shadow: 0 0 0 8px rgba(0, 140, 220, .25); }
  /* digitando: o texto encosta à direita e o começo some, como num campo de verdade */
  .chat--vivo.is-digitando .chat__campo { display: flex; justify-content: flex-end; text-overflow: clip; }

  @media (prefers-reduced-motion: reduce) {
    .chat-luz, .chat-flutua { animation: none; }
  }

  .chat {
    width: 100%;
    max-width: 420px;
    overflow: hidden;
    border: 1px solid var(--line-2);
    border-radius: 24px;
    background: var(--card);
    box-shadow: var(--shadow-hero-card);
    rotate: 1.5deg;
  }
  .chat__topo {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-4) var(--s-5);
    border-bottom: 1px solid var(--line);
    background: var(--card-2);
  }
  .chat__avatar {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--line-2);
  }
  .chat__avatar :global(svg) { width: 20px; height: auto; }
  .chat__nome { font-weight: 600; font-size: 15px; }
  .chat__via { margin-left: auto; font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .chat__corpo { padding: var(--s-8) var(--s-5) var(--s-5); display: flex; flex-direction: column; align-items: flex-end; gap: var(--s-3); }
  .chat__bolha {
    max-width: 88%;
    padding: var(--s-4) var(--s-5);
    border-radius: 18px 18px 4px 18px;
    background: var(--tint-accent);
    border: 1px solid var(--accent);
    font-size: 15px;
    line-height: 1.5;
  }
  .chat__dica { font-size: 12.5px; color: var(--muted); }
  .chat__rodape {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin: 0 var(--s-4) var(--s-4);
    padding: var(--s-2) var(--s-2) var(--s-2) var(--s-4);
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--bg);
  }
  .chat__campo { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 13.5px; color: var(--muted); }
  .chat__enviar { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: var(--brand-white); }

  @media (max-width: 959px) {
    .final__grade { grid-template-columns: minmax(0, 1fr); gap: var(--s-9, 48px); }
    .final h2 { max-width: 22ch; }
    .chat-palco { justify-self: center; }
    .chat { rotate: 0deg; }
  }
  @media (max-width: 619px) {
    .final :global(.final__cta) { width: 100%; }
  }
</style>
