---
import Words from './Words.astro';
import { faq } from '../data/faq';
---

<section id="duvidas" class="section section--junto" aria-labelledby="duvidas-titulo" data-tone="escuro">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="label" data-reveal="label">Dúvidas</p>
      <h2 id="duvidas-titulo" data-reveal="words"><Words text="Antes de chamar no WhatsApp" /></h2>
    </div>

    <div class="faq">
      {faq.map((item, i) => (
        <details data-reveal="up" style={`--i:${i}`}>
          <summary><span class="faq__pergunta">{item.pergunta}</span><span class="faq__icone" aria-hidden="true"></span></summary>
          <p>{item.resposta}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { max-width: 820px; margin: var(--s-9) auto 0; }
  details { border-bottom: 1px solid var(--line); }

  /* Abertura com altura animada onde há suporte (::details-content + interpolate-size) */
  details::details-content {
    block-size: 0;
    overflow: clip;
    transition: block-size .45s var(--ease-out-expo), content-visibility .45s allow-discrete;
  }
  details[open]::details-content { block-size: auto; }
  details p { transition: opacity .4s var(--ease-out-quart) .08s, translate .5s var(--ease-out-expo) .08s; }
  details:not([open]) p { opacity: 0; translate: 0 -6px; }
  summary:hover .faq__pergunta { color: var(--accent); }
  .faq__pergunta { transition: color .2s ease; }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding-block: var(--s-6);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  .faq__pergunta { font-family: var(--font-title); color: var(--text); letter-spacing: -0.01em; font-size: 20px; font-weight: 600; line-height: 1.35; }
  .faq__icone { position: relative; flex: none; width: 28px; height: 28px; transition: transform .25s ease; }
  .faq__icone::before, .faq__icone::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 2px;
    margin: -1px 0 0 -9px;
    border-radius: 2px;
    background: var(--icon-ink);
  }
  .faq__icone::after { transform: rotate(90deg); }
  details[open] .faq__icone { transform: rotate(45deg); }
  details p { padding-bottom: var(--s-6); font-size: 16.5px; color: var(--muted); max-width: 720px; }

  @media (max-width: 619px) {
    .faq__pergunta { font-size: 18px; }
  }
</style>
