---
// Depoimento em vídeo (substitui a antiga seção "Resultado", sem os números do case).
// Palco de cinema: o vídeo vertical no centro sobre a própria capa desfocada (imagem parada, sem 2º vídeo),
// título à esquerda e convite com botão à direita. As legendas já estão gravadas no vídeo.
// Arquivos: public/depoimento/depoimento.mp4 (720x1280, ~17 MB) e depoimento.jpg (capa).
import WhatsAppButton from './WhatsAppButton.astro';

const video = '/depoimento/depoimento.mp4';
const capa = '/depoimento/depoimento.jpg';
---

<section id="depoimento" class="section dep" aria-labelledby="dep-titulo" data-tone="escuro" data-dep style={`--capa:url(${capa})`}>
  <div class="dep__fundo" aria-hidden="true"></div>

  <div class="container dep__grade">
    <div class="dep__titulo">
      <p class="label" data-reveal="label">Depoimento</p>
      <h2 id="dep-titulo" data-reveal="up" style="--d0:80ms">Ouça de quem já passou por aqui.</h2>
    </div>

    <div class="dep__palco" data-reveal="up" style="--d0:160ms">
      <div class="dep__video" data-estado="pausado" data-mudo="sim">
        <video
          src={video}
          poster={capa}
          playsinline
          preload="none"
          aria-label="Depoimento de um cliente sobre trabalhar com a Adverts (legendado)"
          data-dep-video
        ></video>

        <!-- Toque no vídeo: toca e pausa. Fica por cima do vídeo, sob os botões. -->
        <button type="button" class="dep__alvo" data-dep-alterna aria-label="Tocar ou pausar o depoimento"></button>

        <span class="dep__play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" /></svg>
        </span>

        <button type="button" class="dep__som" data-dep-som aria-pressed="false">
          <svg class="dep__som-ic dep__som-ic--mudo" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5Z" /><path d="m22 9-6 6" /><path d="m16 9 6 6" /></svg>
          <svg class="dep__som-ic dep__som-ic--som" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5Z" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /></svg>
          <span data-dep-som-texto>Ativar som</span>
        </button>

        <div class="dep__barra" aria-hidden="true"><i data-dep-progresso></i></div>
      </div>
    </div>

    <div class="dep__convite">
      <p data-reveal="up" style="--d0:200ms">Um cliente fala, com as próprias palavras, sobre trabalhar com a Adverts.</p>
      <div data-reveal="up" style="--d0:320ms"><WhatsAppButton ctaId="cta_depoimento" class="dep__cta" /></div>
    </div>
  </div>
</section>

<script>
  // O vídeo começa sozinho quando a seção entra na tela e pausa quando sai.
  // Som: o navegador só libera áudio automático se a pessoa já interagiu com a página (toque, clique, tecla).
  // Se já interagiu, entra com som; se não, entra mudo e o botão "Ativar som" fica à vista.
  // "Reduzir movimento": não começa sozinho, só ao toque.
  const raiz = document.querySelector<HTMLElement>('[data-dep]');
  if (raiz) {
    const caixa = raiz.querySelector<HTMLElement>('.dep__video')!;
    const v = raiz.querySelector<HTMLVideoElement>('[data-dep-video]')!;
    const btnSom = raiz.querySelector<HTMLButtonElement>('[data-dep-som]')!;
    const textoSom = raiz.querySelector<HTMLElement>('[data-dep-som-texto]')!;
    const alvo = raiz.querySelector<HTMLButtonElement>('[data-dep-alterna]')!;
    const progresso = raiz.querySelector<HTMLElement>('[data-dep-progresso]')!;
    const reduzido = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let visivel = false;
    let pausadoPelaPessoa = false;
    let mudoPorEscolha = false;

    const pintar = () => {
      caixa.dataset.estado = v.paused ? 'pausado' : 'tocando';
      caixa.dataset.mudo = v.muted ? 'sim' : 'nao';
      textoSom.textContent = v.muted ? 'Ativar som' : 'Som ligado';
      btnSom.setAttribute('aria-pressed', String(!v.muted));
    };

    const tocar = async () => {
      const jaInteragiu = (navigator as Navigator & { userActivation?: { hasBeenActive: boolean } }).userActivation?.hasBeenActive ?? false;
      v.muted = mudoPorEscolha || !jaInteragiu;
      try {
        await v.play();
      } catch {
        if (!v.muted) {
          v.muted = true;
          try { await v.play(); } catch { /* sem permissão: fica na capa com o botão de tocar */ }
        }
      }
      pintar();
    };

    new IntersectionObserver(
      ([e]) => {
        visivel = e.isIntersecting;
        if (visivel) {
          if (!pausadoPelaPessoa && !reduzido) tocar();
        } else {
          pausadoPelaPessoa = false;
          if (!v.paused) v.pause();
        }
      },
      { threshold: 0.55 },
    ).observe(caixa);

    // Toque no vídeo: o gesto libera o som (salvo se a pessoa tiver silenciado de propósito).
    alvo.addEventListener('click', () => {
      if (v.paused) {
        pausadoPelaPessoa = false;
        v.muted = mudoPorEscolha;
        v.play().catch(() => {});
      } else {
        pausadoPelaPessoa = true;
        v.pause();
      }
    });

    btnSom.addEventListener('click', () => {
      v.muted = !v.muted;
      mudoPorEscolha = v.muted;
      if (!v.muted && v.paused) { pausadoPelaPessoa = false; v.play().catch(() => {}); }
      pintar();
    });

    v.addEventListener('play', pintar);
    v.addEventListener('pause', pintar);
    v.addEventListener('volumechange', pintar);
    v.addEventListener('timeupdate', () => {
      if (v.duration) progresso.style.transform = `scaleX(${v.currentTime / v.duration})`;
    });
    v.addEventListener('ended', () => { v.currentTime = 0; progresso.style.transform = 'scaleX(0)'; pintar(); });
    pintar();
  }
</script>

<style>
  .dep { position: relative; isolation: isolate; overflow: clip; padding-block: var(--s-12); }

  /* capa desfocada (imagem parada) atrás de tudo: dá o clima de palco sem custo de um segundo vídeo */
  .dep__fundo {
    position: absolute;
    inset: -40px;
    z-index: -1;
    background: var(--capa) center / cover no-repeat;
    filter: blur(34px) brightness(.38) saturate(1.35);
    transform: scale(1.15);
  }
  .dep::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, var(--bg) 0%, transparent 18%, transparent 82%, var(--bg) 100%);
    pointer-events: none;
  }

  .dep__grade {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-10);
  }
  .dep__titulo h2 { margin-top: var(--s-4); font-size: clamp(30px, 3.4vw, 46px); max-width: 14ch; }
  .dep__convite { justify-self: end; max-width: 340px; }
  .dep__convite p { color: var(--muted); font-size: 17px; line-height: 1.55; }
  .dep__convite :global(.dep__cta) { margin-top: var(--s-6); }

  /* ---------- vídeo vertical ---------- */
  .dep__palco { display: flex; justify-content: center; }
  .dep__video {
    position: relative;
    width: clamp(220px, 21vw, 300px);
    aspect-ratio: 9 / 16;
    border-radius: var(--r-hero-card);
    overflow: hidden;
    background: #0B1530;
    border: 1px solid var(--line-2);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .85), 0 0 0 1px rgba(253, 185, 19, .18);
  }
  .dep__video video { display: block; width: 100%; height: 100%; object-fit: cover; }

  .dep__alvo { position: absolute; inset: 0; z-index: 1; padding: 0; border: 0; background: transparent; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .dep__alvo:focus-visible { outline-offset: -4px; }

  /* botão grande de tocar: só aparece com o vídeo parado */
  .dep__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    translate: -50% -50%;
    border-radius: 50%;
    color: #fff;
    background: rgba(5, 11, 26, .62);
    border: 1px solid rgba(255, 255, 255, .35);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    pointer-events: none;
    transition: opacity .25s ease, scale .35s var(--ease-out-expo);
  }
  .dep__play :global(svg) { margin-left: 3px; }
  .dep__video[data-estado='tocando'] .dep__play { opacity: 0; scale: .8; }

  /* botão de som: sempre à vista (pílula) */
  .dep__som {
    position: absolute;
    left: 50%;
    bottom: 16px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    padding: 8px 15px;
    translate: -50% 0;
    border-radius: var(--r-pill);
    border: 1px solid rgba(255, 255, 255, .3);
    background: rgba(5, 11, 26, .78);
    color: #fff;
    font: 600 13px/1 var(--font-body);
    white-space: nowrap;
    cursor: pointer;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition: background-color .2s ease, border-color .2s ease;
  }
  .dep__som:hover { background: rgba(5, 11, 26, .92); border-color: rgba(255, 255, 255, .5); }
  .dep__video[data-mudo='sim'] .dep__som { border-color: var(--accent-2); }
  .dep__video[data-mudo='sim'] .dep__som-ic--som,
  .dep__video[data-mudo='nao'] .dep__som-ic--mudo { display: none; }

  .dep__barra { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; height: 3px; background: rgba(255, 255, 255, .18); pointer-events: none; }
  .dep__barra i { display: block; width: 100%; height: 100%; background: var(--accent-2); transform: scaleX(0); transform-origin: 0 50%; }

  @media (max-width: 959px) {
    .dep { padding-block: var(--s-11); }
    .dep__grade { grid-template-columns: 1fr; justify-items: center; gap: var(--s-8); text-align: center; }
    .dep__titulo h2 { max-width: 18ch; margin-inline: auto; }
    .dep__titulo .label { justify-content: center; }
    .dep__video { width: min(300px, 78vw); }
    .dep__convite { justify-self: center; max-width: 34ch; }
    .dep__convite :global(.dep__cta) { width: 100%; }
  }
</style>
