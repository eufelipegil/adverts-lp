---
import { depoimentos } from '../data/depoimentos';
// Seção inteira só existe se houver depoimentos (título incluído).
---

{depoimentos.length > 0 && (
  <section class="section section--junto" aria-labelledby="depoimentos-titulo" data-tone="escuro">
    <div class="container">
      <div class="section-head">
        <h2 id="depoimentos-titulo">Quem já trabalha com a Adverts</h2>
      </div>
      <ul class="depo__lista">
        {depoimentos.map((d, i) => (
          <li class="card depo" data-reveal="up" style={`--i:${i % 3}`}>
            <blockquote>
              <p>{d.texto}</p>
            </blockquote>
            <p class="depo__nome">{d.nome}</p>
            <p class="depo__cargo">{[d.cargo, d.empresa].filter(Boolean).join(', ')}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .depo__lista {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-5);
    margin-top: var(--s-10);
  }
  .depo { position: relative; display: flex; flex-direction: column; }
  .depo::before {
    content: '\201C';
    position: absolute;
    top: 4px;
    right: 20px;
    font-family: var(--font-title);
    font-size: 96px;
    line-height: 1;
    color: var(--quote-mark);
  }
  .depo blockquote { margin: 0; flex: 1; }
  .depo blockquote p { font-size: 16.5px; color: var(--text); }
  .depo__nome { margin-top: var(--s-6); font-family: var(--font-title); font-size: 18px; font-weight: 600; color: var(--text) !important; }
  .depo__cargo { margin-top: var(--s-1); font-size: 14px !important; }

  @media (max-width: 959px) {
    .depo__lista { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 619px) {
    .depo__lista {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 86%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: var(--s-2);
    }
    .depo { scroll-snap-align: start; }
  }
</style>
