---
// Depoimento em vídeo (substitui a antiga seção "Resultado", sem os números do case).
// Layout no estilo do site da Valentina: texto e cards à esquerda, vídeo vertical em moldura de celular à
// direita, com um círculo de cor atrás e o botão de som só com ícone no canto. As legendas já estão gravadas no vídeo.
// Arquivos: public/depoimento/depoimento.mp4 (720x1280, ~17 MB) e depoimento.jpg (capa).
import WhatsAppButton from './WhatsAppButton.astro';
import Icon from './Icon.astro';

const video = '/depoimento/depoimento.mp4';
const capa = '/depoimento/depoimento.jpg';
// Só o que já está aprovado no site (hero e sócios): nada inventado.
const cards = [
  { icone: 'target', titulo: 'Aquisição de clientes para revendas', texto: 'Anúncios no Google e no Meta, página que converte, CRM organizado e automação.' },
  { icone: 'code', titulo: 'Sócios que vêm de tecnologia', texto: 'Quem fala com você já viveu a venda de software do outro lado.' },
] as const;
---

<section id="depoimento" class="section dep" aria-labelledby="dep-titulo" data-tone="escuro" data-dep>
  <div class="container dep__grade">
    <div class="dep__texto">
    <div class="dep__titulo">
      <p class="label" data-reveal="label">Depoimento</p>
      <h2 id="dep-titulo" data-reveal="up" style="--d0:80ms">Ouça de quem <span class="dep__dest">já passou por aqui.</span></h2>
    </div>

    <ul class="dep__cards">
      {cards.map((c, i) => (
        <li class="dep__card" data-reveal="up" style={`--d0:${180 + i * 100}ms`}>
          <span class="dep__card-ic"><Icon name={c.icone} size={22} /></span>
          <div>
            <h3>{c.titulo}</h3>
            <p>{c.texto}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="dep__cta-bloco" data-reveal="up" style="--d0:380ms"><WhatsAppButton ctaId="cta_depoimento" class="dep__cta" /></div>
    </div>

    <div class="dep__palco" data-reveal="up" style="--d0:160ms">
      <span class="dep__circulo" aria-hidden="true"></span>
      <div class="dep__moldura">
        <div class="dep__video" data-estado="pausado" data-mudo="sim">
          <video
            src={video}
            poster={capa}
            muted
            loop
            playsinline
            preload="none"
            aria-label="Depoimento de um cliente sobre trabalhar com a Adverts (legendado)"
            data-dep-video
          ></video>

          <!-- Toque no vídeo: toca e pausa (ou, se estiver mudo, liga o som). Fica sob os botões. -->
          <button type="button" class="dep__alvo" data-dep-alterna aria-label="Tocar ou pausar o depoimento"></button>

          <span class="dep__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" /></svg>
          </span>

          <!-- O ícone mostra o ESTADO: com X = sem som (toque para ligar); com ondas = som ligado. -->
          <button type="button" class="dep__som" data-dep-som aria-pressed="false" aria-label="Ativar o som do vídeo">
            <svg class="dep__som-ic dep__som-ic--mudo" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5Z" /><path d="m22 9-6 6" /><path d="m16 9 6 6" /></svg>
            <svg class="dep__som-ic dep__som-ic--som" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5Z" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /></svg>
          </button>
          <span class="dep__dica" aria-hidden="true">Toque para ouvir</span>

          <div class="dep__barra" aria-hidden="true"><i data-dep-progresso></i></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Mesma ideia do site da Valentina. O vídeo começa quando a seção entra na tela e pausa quando sai.
  //   1. tenta tocar COM SOM ao entrar na seção;
  //   2. se o navegador barrar (sem interação prévia; rolar não conta), segue mudo e arma um gatilho:
  //      no primeiro toque, clique ou tecla em qualquer lugar da página, o som liga se o vídeo estiver à vista;
  //   3. se a pessoa silenciar no botão, a escolha dela vale e nada religa.
  // "Reduzir movimento": não começa sozinho, só ao toque.
  const raiz = document.querySelector<HTMLElement>('[data-dep]');
  if (raiz) {
    const caixa = raiz.querySelector<HTMLElement>('.dep__video')!;
    const v = raiz.querySelector<HTMLVideoElement>('[data-dep-video]')!;
    const btnSom = raiz.querySelector<HTMLButtonElement>('[data-dep-som]')!;
    const alvo = raiz.querySelector<HTMLButtonElement>('[data-dep-alterna]')!;
    const progresso = raiz.querySelector<HTMLElement>('[data-dep-progresso]')!;
    const reduzido = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let naTela = false;
    let pausadoPelaPessoa = false;
    let mudoPorEscolha = false;
    let somLigadoEm = 0;

    const pintar = () => {
      caixa.dataset.estado = v.paused ? 'pausado' : 'tocando';
      caixa.dataset.mudo = v.muted ? 'sim' : 'nao';
      btnSom.setAttribute('aria-pressed', String(!v.muted));
      btnSom.setAttribute('aria-label', v.muted ? 'Ativar o som do vídeo' : 'Desativar o som do vídeo');
    };

    const tocarComSom = async () => {
      v.muted = false;
      try {
        await v.play();
        somLigadoEm = Date.now();
      } catch {
        // autoplay com áudio barrado: segue mudo até a pessoa interagir
        v.muted = true;
        try { await v.play(); } catch { /* sem permissão: fica na capa com o botão de tocar */ }
      }
      pintar();
    };

    new IntersectionObserver(
      ([e]) => {
        naTela = e.isIntersecting;
        if (!naTela) {
          pausadoPelaPessoa = false;
          if (!v.paused) v.pause();
          return;
        }
        if (reduzido || pausadoPelaPessoa) return;
        if (mudoPorEscolha) { v.muted = true; v.play().catch(() => {}); pintar(); }
        else tocarComSom();
      },
      { threshold: 0.5 },
    ).observe(caixa);

    // Primeiro gesto da página: é a partir dele que o navegador libera o áudio.
    const aoPrimeiroGesto = (e: Event) => {
      if (btnSom.contains(e.target as Node)) return; // o botão cuida de si
      if (mudoPorEscolha || !naTela || !v.muted || v.paused) return;
      tocarComSom();
    };
    (['pointerdown', 'keydown', 'touchend'] as const).forEach((ev) =>
      document.addEventListener(ev, aoPrimeiroGesto, { capture: true, passive: true }),
    );

    // Toque no vídeo: toca e pausa. Se o toque acabou de ligar o som, não pausa em seguida.
    alvo.addEventListener('click', () => {
      if (Date.now() - somLigadoEm < 700) return;
      if (v.paused) {
        pausadoPelaPessoa = false;
        v.muted = mudoPorEscolha;
        v.play().catch(() => {});
      } else {
        pausadoPelaPessoa = true;
        v.pause();
      }
    });

    btnSom.addEventListener('click', () => {
      v.muted = !v.muted;
      mudoPorEscolha = v.muted;
      if (!v.muted && v.paused) { pausadoPelaPessoa = false; v.play().catch(() => {}); }
      pintar();
    });

    v.addEventListener('play', pintar);
    v.addEventListener('pause', pintar);
    v.addEventListener('volumechange', pintar);
    v.addEventListener('timeupdate', () => {
      if (v.duration) progresso.style.transform = `scaleX(${v.currentTime / v.duration})`;
    });
    pintar();
  }
</script>

<style>
  .dep { position: relative; isolation: isolate; overflow: clip; padding-block: var(--s-12); }

  /*
    Desktop: texto, cards e botão à esquerda; o vídeo ocupa as 3 linhas à direita.
    Celular: título, vídeo, cards, botão (a ordem do HTML + as áreas abaixo).
  */
  .dep__grade {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'texto palco';
    align-items: center;
    column-gap: clamp(var(--s-8), 7vw, 120px);
  }
  .dep__texto { grid-area: texto; display: grid; gap: var(--s-6); justify-items: start; }
  .dep__titulo h2 { margin-top: var(--s-4); font-size: clamp(32px, 3.6vw, 50px); max-width: 15ch; }
  .dep__dest { color: var(--accent); }
  .dep__cards { display: grid; gap: var(--s-3); width: 100%; max-width: 560px; }
  .dep__cta-bloco { margin-top: var(--s-4); }
  .dep__palco { grid-area: palco; position: relative; align-self: center; display: flex; justify-content: center; }

  /* ---------- cards ---------- */
  .dep__card {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-5);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
  }
  .dep__card-ic {
    display: grid;
    place-items: center;
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--tint-accent);
    color: var(--accent);
  }
  .dep__card h3 { font-size: 17px; line-height: 1.25; letter-spacing: -0.01em; font-stretch: 100%; }
  .dep__card p { margin-top: 4px; font-size: 14.5px; line-height: 1.5; color: var(--muted); }

  /* ---------- moldura de celular + círculo ---------- */
  .dep__circulo {
    position: absolute;
    top: -70px;
    left: -90px;
    width: 280px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 140, 220, .42), rgba(0, 140, 220, .16) 70%, rgba(0, 140, 220, .06));
    pointer-events: none;
  }
  .dep__moldura {
    position: relative;
    padding: 12px;
    border-radius: 42px;
    background: linear-gradient(160deg, rgba(255, 255, 255, .14), rgba(255, 255, 255, .05));
    border: 1px solid var(--line-2);
    box-shadow: 0 50px 90px -35px rgba(0, 0, 0, .9), inset 0 1px 0 rgba(255, 255, 255, .2);
  }
  .dep__video {
    position: relative;
    width: clamp(240px, 22vw, 316px);
    aspect-ratio: 9 / 16;
    border-radius: 30px;
    overflow: hidden;
    background: #0B1530;
  }
  .dep__video video { display: block; width: 100%; height: 100%; object-fit: cover; }

  .dep__alvo { position: absolute; inset: 0; z-index: 1; padding: 0; border: 0; background: transparent; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .dep__alvo:focus-visible { outline-offset: -4px; }

  /* botão grande de tocar: só aparece com o vídeo parado */
  .dep__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    translate: -50% -50%;
    border-radius: 50%;
    color: #fff;
    background: rgba(5, 11, 26, .62);
    border: 1px solid rgba(255, 255, 255, .35);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    pointer-events: none;
    transition: opacity .25s ease, scale .35s var(--ease-out-expo);
  }
  .dep__play :global(svg) { margin-left: 3px; }
  .dep__video[data-estado='tocando'] .dep__play { opacity: 0; scale: .8; }

  /* botão de som: círculo só com ícone, no canto (como no site da Valentina) */
  .dep__som {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--accent-2);
    color: #0A0A0A;
    cursor: pointer;
    box-shadow: 0 8px 20px -6px rgba(0, 0, 0, .7);
    transition: scale .2s var(--ease-out-quart);
  }
  .dep__som:hover { scale: 1.08; }
  .dep__som:active { scale: .94; }
  .dep__video[data-mudo='sim'] .dep__som-ic--som,
  .dep__video[data-mudo='nao'] .dep__som-ic--mudo { display: none; }

  /* enquanto está mudo: anel que pulsa e a dica ao lado, para a pessoa ver que dá para ligar o som */
  .dep__som::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--accent-2);
    opacity: 0;
    pointer-events: none;
  }
  .dep__dica {
    position: absolute;
    top: 25px;
    right: 72px;
    z-index: 3;
    translate: 0 -50%;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: rgba(5, 11, 26, .8);
    border: 1px solid rgba(255, 255, 255, .25);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity .3s ease;
  }
  .dep__video[data-mudo='sim'][data-estado='tocando'] .dep__dica { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .dep__video[data-mudo='sim'][data-estado='tocando'] .dep__som::after { animation: dep-pulso 1.8s ease-out infinite; }
  }
  @keyframes dep-pulso { 0% { opacity: .9; scale: 1; } 100% { opacity: 0; scale: 1.7; } }

  .dep__barra { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; height: 3px; background: rgba(255, 255, 255, .18); pointer-events: none; }
  .dep__barra i { display: block; width: 100%; height: 100%; background: var(--accent-2); transform: scaleX(0); transform-origin: 0 50%; }

  @media (max-width: 959px) {
    .dep { padding-block: var(--s-11); }
    /* celular: o bloco de texto se desfaz (display: contents) para o vídeo ficar entre o título e os cards */
    .dep__grade {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'titulo' 'palco' 'cards' 'cta';
      justify-items: center;
      text-align: center;
      row-gap: var(--s-8);
    }
    .dep__texto { display: contents; }
    .dep__titulo { grid-area: titulo; }
    .dep__cards { grid-area: cards; }
    .dep__cta-bloco { grid-area: cta; margin-top: 0; }
    .dep__palco { grid-area: palco; }
    .dep__titulo h2 { max-width: 18ch; margin-inline: auto; }
    .dep__titulo .label { justify-content: center; }
    .dep__cards { width: 100%; max-width: 520px; text-align: left; }
    .dep__cta-bloco { width: 100%; max-width: 520px; }
    .dep__cta-bloco :global(.dep__cta) { width: 100%; }
    .dep__video { width: min(280px, 72vw); }
    .dep__circulo { width: 220px; top: -50px; left: -60px; }
  }
</style>
